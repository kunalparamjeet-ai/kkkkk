# ==============================================================================
# VEKTOR AI — Environment Configuration Template
# Copy this file to .env for local development. Never commit real secrets.
# ==============================================================================

# Server & Runtime
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
SESSION_SECRET="replace-with-a-64-char-random-secret"

# PostgreSQL Database (Render / Production)
# When omitted in local development, VEKTOR AI falls back to atomic local store persistence.
DATABASE_URL="postgresql://vektor:password@localhost:5432/vektor_ai"

# Optional Redis Worker Queue (Render / Background Jobs)
REDIS_URL=""

# AI Model Providers (Server-Side Only — Never Expose to Browser)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
DEEPSEEK_API_KEY=""

# Self-Hosted VEKTOR Coding Model (Open-Weight Inference Server)
VEKTOR_INFERENCE_URL=""
VEKTOR_INFERENCE_API_KEY=""
VEKTOR_MODEL_WEIGHTS_PATH=""
VEKTOR_MODEL_NAME="vektor-coder-1"

# Google OAuth 2.0 (Sign-In)
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# GitHub OAuth (Repository Sync & Push)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Billing & Payment Gateways
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# VEKTOR Managed Hosting Domain
VEKTOR_HOSTING_DOMAIN="vektor.app"
